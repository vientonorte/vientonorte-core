{
  "name": "vientonorte-core",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo ra\u00edz del colectivo vientonorte",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "storybook": "pnpm --filter @vientonorte/storybook dev",
    "storybook:build": "pnpm --filter @vientonorte/storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0"
  }
}

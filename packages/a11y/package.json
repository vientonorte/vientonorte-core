{
  "name": "@vientonorte/a11y",
  "version": "0.1.1",
  "description": "Helpers de accesibilidad WCAG 2.2 para el colectivo vientonorte",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vientonorte/vientonorte-core.git",
    "directory": "packages/a11y"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

{
  "name": "@vientonorte/security",
  "version": "0.1.1",
  "description": "Factor Registry + step-up auth para el colectivo vientonorte",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vientonorte/vientonorte-core.git",
    "directory": "packages/security"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
